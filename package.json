{
  "name": "octosift",
  "version": "0.1.0",
  "private": true,
  "description": "Find Reddit posts from people who need your product and prepare reviewed replies.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octosift/octosift.git"
  },
  "homepage": "https://github.com/Octosift/octosift#readme",
  "bugs": "https://github.com/Octosift/octosift/issues",
  "type": "module",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm db:migrate && concurrently -k -n web,worker -c cyan,magenta \"pnpm:dev:web\" \"pnpm:dev:worker\"",
    "dev:web": "NEXT_TELEMETRY_DISABLED=1 next dev -H ${HOST:-127.0.0.1} -p ${PORT:-3005}",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "pnpm db:migrate && concurrently -k -n web,worker -c cyan,magenta \"pnpm:start:web\" \"pnpm:start:worker\"",
    "start:web": "NEXT_TELEMETRY_DISABLED=1 next start -H ${HOST:-127.0.0.1} -p ${PORT:-3005}",
    "start:worker": "tsx src/worker/index.ts",
    "demo": "DATABASE_PATH=data/demo.sqlite tsx scripts/seed-demo.ts && DATABASE_PATH=data/demo.sqlite DEMO_MODE=1 concurrently -k -n web,worker -c cyan,magenta \"pnpm:dev:web\" \"pnpm:dev:worker\"",
    "worker": "tsx src/worker/index.ts",
    "scan": "tsx src/cli/index.ts scan",
    "eval": "tsx src/cli/index.ts eval",
    "cli": "tsx src/cli/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "format": "prettier --write .",
    "leakcheck": "bash scripts/leakcheck.sh --all",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm leakcheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/openai": "^4",
    "@ai-sdk/openai-compatible": "^3",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7",
    "better-sqlite3": "^13.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "franc-min": "^6.2.0",
    "geist": "^1.9.2",
    "linkedom": "^0.18.15",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "playwright": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  }
}
