# Copy to .env and fill in what you need. Everything is optional.

# Where the SQLite database lives (default data/app.sqlite).
DATABASE_PATH=
# Encrypts saved API keys. If empty, a random key is stored in data/.secret.
APP_SECRET=
# Require this password to open the dashboard. Set it before exposing the app.
APP_PASSWORD=
# debug, info, warn or error (default info).
LOG_LEVEL=
# Address used for links in notifications (default http://127.0.0.1:3000).
PUBLIC_URL=
# Interface and port for the dashboard (default 127.0.0.1 and 3000).
HOST=
PORT=
# 1 runs with synthetic data and a simulated AI provider.
DEMO_MODE=

# Provider keys. When set here they take precedence over keys saved in the dashboard.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# A connected Reddit account's Cookie header, instead of connecting it in Settings.
REDDIT_SESSION_COOKIE=
# A data provider key, for reading Reddit through a paid provider (see docs/sources.md).
VENDOR_API_KEY=

# Optional proxy for Reddit reads, and an optional webhook for strong leads.
REDDIT_PROXY_URL=
WEBHOOK_URL=

# Optional: DataForSEO API credentials for the Evergreen tab (threads that rank on Google).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
